<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'ShopSphere' %></title>
  <!-- Google Fonts & Font Awesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top Announcement Bar -->
  <div class="top-bar">
    <div class="container top-bar-content">
      <span><i class="fa-solid fa-truck-fast"></i> Free Shipping on orders over $100!</span>
      <div class="top-bar-links">
        <a href="#"><i class="fa-solid fa-headset"></i> Support</a>
        <a href="#"><i class="fa-solid fa-globe"></i> EN / USD</a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Header -->
  <header class="navbar">
    <div class="container nav-container">
      <!-- Brand Logo -->
      <a href="/" class="brand-logo">
        <span class="logo-icon"><i class="fa-solid fa-bolt"></i></span>
        <span class="logo-text">Shop<span class="highlight">Sphere</span></span>
      </a>

      <!-- Search Bar -->
      <form action="/products" method="GET" class="search-form">
        <div class="search-input-wrapper">
          <input 
            type="text" 
            name="search" 
            placeholder="Search products, brands, categories..." 
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            autocomplete="off"
          >
          <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>
      </form>

      <!-- Action Buttons (Cart, Account) -->
      <div class="nav-actions">
        <!-- Shopping Cart Icon with Badge -->
        <a href="/cart" class="nav-icon-link cart-link" title="Shopping Cart">
          <i class="fa-solid fa-bag-shopping"></i>
          <span class="badge" id="cart-badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
          <span class="cart-label">Cart</span>
        </a>

        <!-- User Authentication Section -->
        <% if (locals.user) { %>
          <div class="user-menu-dropdown">
            <button class="user-btn">
              <i class="fa-solid fa-user-circle"></i>
              <span class="user-name"><%= locals.user.full_name %></span>
              <i class="fa-solid fa-chevron-down arrow-icon"></i>
            </button>
            <div class="dropdown-content">
              <div class="dropdown-header">
                <strong><%= locals.user.username %></strong>
                <small><%= locals.user.email %></small>
              </div>
              <hr>
              <a href="/orders"><i class="fa-solid fa-box"></i> My Orders</a>
              <a href="/auth/logout" class="logout-item"><i class="fa-solid fa-right-from-bracket"></i> Sign Out</a>
            </div>
          </div>
        <% } else { %>
          <div class="auth-buttons">
            <a href="/login" class="btn btn-outline-sm">Sign In</a>
            <a href="/register" class="btn btn-primary-sm">Register</a>
          </div>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Category Navigation Bar -->
  <nav class="category-nav">
    <div class="container category-container">
      <a href="/products" class="<%= typeof selectedCategory === 'undefined' || selectedCategory === 'all' ? 'active' : '' %>">
        <i class="fa-solid fa-border-all"></i> All Products
      </a>
      <a href="/products?category=Electronics" class="<%= typeof selectedCategory !== 'undefined' && selectedCategory === 'Electronics' ? 'active' : '' %>">
        <i class="fa-solid fa-laptop"></i> Electronics
      </a>
      <a href="/products?category=Fashion" class="<%= typeof selectedCategory !== 'undefined' && selectedCategory === 'Fashion' ? 'active' : '' %>">
        <i class="fa-solid fa-shirt"></i> Fashion
      </a>
      <a href="/products?category=Accessories" class="<%= typeof selectedCategory !== 'undefined' && selectedCategory === 'Accessories' ? 'active' : '' %>">
        <i class="fa-solid fa-glasses"></i> Accessories
      </a>
      <a href="/products?category=Home %26 Living" class="<%= typeof selectedCategory !== 'undefined' && selectedCategory === 'Home & Living' ? 'active' : '' %>">
        <i class="fa-solid fa-couch"></i> Home & Living
      </a>
    </div>
  </nav>

  <!-- Notification Toast Container -->
  <div id="toast-container" class="toast-container"></div>

  <!-- Main Content Wrapper -->
  <main class="main-content">
