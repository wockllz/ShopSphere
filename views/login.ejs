<%- include('partials/header') %>

<div class="container page-wrapper flex-center">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-icon-circle">
        <i class="fa-solid fa-user-lock"></i>
      </div>
      <h1>Welcome Back</h1>
      <p>Sign in to your CodeAlpha Store account</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
      </div>
    <% } %>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-info">
        <i class="fa-solid fa-info-circle"></i> <%= message %>
      </div>
    <% } %>

    <form action="/login" method="POST" class="auth-form">
      <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/' %>">

      <div class="form-group">
        <label for="email"><i class="fa-solid fa-envelope"></i> Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="demo@example.com"
        >
      </div>

      <div class="form-group">
        <label for="password"><i class="fa-solid fa-lock"></i> Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          placeholder="••••••••"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">
        Sign In <i class="fa-solid fa-right-to-bracket"></i>
      </button>
    </form>

    <div class="auth-demo-hint">
      <small><i class="fa-solid fa-key"></i> Demo User: <strong>demo@example.com</strong> / Password: <strong>password123</strong></small>
    </div>

    <div class="auth-footer">
      <p>Don't have an account yet? <a href="/register">Create an account</a></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
