<%- include('partials/header') %>

<div class="container page-wrapper">
  <div class="page-header">
    <h1><i class="fa-solid fa-credit-card"></i> Checkout</h1>
    <p>Complete your shipping and payment information to place your order.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger">
      <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
    </div>
  <% } %>

  <div class="checkout-layout">
    <!-- Form Section -->
    <div class="checkout-form-column">
      <form action="/orders/checkout" method="POST" class="checkout-form">
        
        <!-- Shipping Details -->
        <div class="form-section">
          <h2><i class="fa-solid fa-truck"></i> 1. Shipping Details</h2>
          <div class="form-group">
            <label for="shipping_name">Full Name *</label>
            <input 
              type="text" 
              id="shipping_name" 
              name="shipping_name" 
              value="<%= locals.user ? locals.user.full_name : '' %>" 
              required 
              placeholder="Jane Doe"
            >
          </div>

          <div class="form-group">
            <label for="shipping_address">Street Address *</label>
            <input 
              type="text" 
              id="shipping_address" 
              name="shipping_address" 
              required 
              placeholder="123 Main Street, Apt 4B"
            >
          </div>

          <div class="form-row">
            <div class="form-group col-half">
              <label for="shipping_city">City *</label>
              <input 
                type="text" 
                id="shipping_city" 
                name="shipping_city" 
                required 
                placeholder="New York"
              >
            </div>
            <div class="form-group col-half">
              <label for="shipping_zip">Zip / Postal Code *</label>
              <input 
                type="text" 
                id="shipping_zip" 
                name="shipping_zip" 
                required 
                placeholder="10001"
              >
            </div>
          </div>
        </div>

        <!-- Payment Options -->
        <div class="form-section">
          <h2><i class="fa-solid fa-wallet"></i> 2. Payment Method</h2>
          <div class="payment-options">
            <label class="payment-card selected">
              <input type="radio" name="payment_method" value="Credit Card" checked>
              <div class="payment-info">
                <i class="fa-solid fa-credit-card payment-icon"></i>
                <div>
                  <strong>Credit / Debit Card</strong>
                  <p>Visa, Mastercard, Amex</p>
                </div>
              </div>
            </label>

            <label class="payment-card">
              <input type="radio" name="payment_method" value="PayPal">
              <div class="payment-info">
                <i class="fa-brands fa-paypal payment-icon"></i>
                <div>
                  <strong>PayPal</strong>
                  <p>Fast & secure digital checkout</p>
                </div>
              </div>
            </label>

            <label class="payment-card">
              <input type="radio" name="payment_method" value="Cash on Delivery">
              <div class="payment-info">
                <i class="fa-solid fa-money-bill-wave payment-icon"></i>
                <div>
                  <strong>Cash on Delivery (COD)</strong>
                  <p>Pay when package is delivered</p>
                </div>
              </div>
            </label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block place-order-btn">
          <i class="fa-solid fa-check-circle"></i> Complete Order ($<%= cartSummary.total %>)
        </button>
      </form>
    </div>

    <!-- Summary Column -->
    <div class="checkout-summary-column">
      <div class="summary-card">
        <h2>Order Review (<%= cartItems.length %> items)</h2>
        <div class="checkout-items-list">
          <% cartItems.forEach(item => { %>
            <div class="checkout-item">
              <img src="<%= item.product.image_url %>" alt="<%= item.product.name %>" class="item-thumb">
              <div class="item-details">
                <span class="item-name"><%= item.product.name %></span>
                <span class="item-qty">Qty: <%= item.quantity %> &times; $<%= item.product.price.toFixed(2) %></span>
              </div>
              <span class="item-total">$<%= item.itemTotal.toFixed(2) %></span>
            </div>
          <% }); %>
        </div>

        <hr class="summary-divider">

        <div class="summary-row">
          <span>Subtotal</span>
          <span>$<%= cartSummary.subtotal %></span>
        </div>
        <div class="summary-row">
          <span>Estimated Tax</span>
          <span>$<%= cartSummary.tax %></span>
        </div>
        <div class="summary-row">
          <span>Shipping</span>
          <span><%= parseFloat(cartSummary.shipping) === 0 ? 'FREE' : '$' + cartSummary.shipping %></span>
        </div>

        <hr class="summary-divider">

        <div class="summary-row total-row">
          <span>Total Amount</span>
          <span class="total-amount">$<%= cartSummary.total %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
